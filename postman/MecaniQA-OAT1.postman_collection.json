  "item": [
    {
      "name": "Peças",
      "description": "Execute as requisições na ordem para reutilizar o código gerado no cadastro.",
      "item": [
        {
          "name": "1. Cadastrar peça",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const resposta = pm.response.json();",
                  "pm.collectionVariables.set('pecaCodigo', resposta.codigo);",
                  "pm.test('Código e datas foram gerados', function () {",
                  "    pm.expect(resposta.codigo).to.be.a('number');",
                  "    pm.expect(resposta.dataCadastro).to.exist;",
                  "    pm.expect(resposta.dataUltimaAtualizacao).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoBarras\": \"7891234567890\",\n  \"fornecedorMarca\": \"Bosch\",\n  \"quantidadeEstoque\": 12,\n  \"precoCusto\": 80.50,\n  \"precoVenda\": 125.90,\n  \"tamanho\": \"M\",\n  \"cor\": \"Preta\",\n  \"categoria\": \"FREIOS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pecas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pecas"]
            },
            "description": "US01 - Cadastro de nova peça."
          }
        },
        {
          "name": "2. Listar peças",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Resposta é uma lista', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pecas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pecas"]
            },
            "description": "US02 - Lista o catálogo de peças."
          }
        },
        {
          "name": "3. Buscar peça por código",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Código corresponde ao cadastrado', function () {",
                  "    pm.expect(String(pm.response.json().codigo)).to.eql(pm.collectionVariables.get('pecaCodigo'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pecas/{{pecaCodigo}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pecas", "{{pecaCodigo}}"]
            },
            "description": "US02 - Consulta uma peça pelo código único."
          }
        },
        {
          "name": "4. Atualizar peça",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Estoque e preços foram atualizados', function () {",
                  "    const resposta = pm.response.json();",
                  "    pm.expect(resposta.quantidadeEstoque).to.eql(20);",
                  "    pm.expect(resposta.precoVenda).to.eql(140.00);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantidadeEstoque\": 20,\n  \"precoCusto\": 90.00,\n  \"precoVenda\": 140.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pecas/{{pecaCodigo}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pecas", "{{pecaCodigo}}"]
            },
            "description": "US03 - Atualiza quantidade e preços da peça."
          }
        },
        {
          "name": "5. Excluir peça",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "pm.test('Resposta sem corpo', function () {",
                  "    pm.expect(pm.response.text()).to.eql('');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pecas/{{pecaCodigo}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pecas", "{{pecaCodigo}}"]
            },
            "description": "US04 - Exclui uma peça obsoleta."
          }
        }
      ]
    },
